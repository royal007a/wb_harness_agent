{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/schemas/task-registry.schema.json",
  "title": "HarnessAgent Task Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "tasks"],
  "properties": {
    "$schema": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "risk",
        "scope",
        "non_goals",
        "acceptance",
        "depends_on",
        "owner",
        "plan",
        "blocked_reason",
        "recovery_condition",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^HA-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 3},
        "status": {
          "enum": [
            "backlog",
            "ready",
            "running",
            "waiting_approval",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "non_goals": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "acceptance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": {"type": "string", "pattern": "^HA-[0-9]{4}$"},
          "uniqueItems": true
        },
        "owner": {"type": ["string", "null"]},
        "plan": {"type": ["string", "null"]},
        "blocked_reason": {"type": ["string", "null"]},
        "recovery_condition": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
