{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/schemas/adaptive-chunk@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_text", "source_sha256", "parents", "children", "parent_max_chars", "max_child_chars"],
  "properties": {
    "schema_version": {"const": "adaptive-chunk@1"},
    "source_text": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parents": {"type": "array", "items": {"$ref": "#/$defs/parent"}},
    "children": {"type": "array", "items": {"$ref": "#/$defs/child"}},
    "parent_max_chars": {"type": "integer", "minimum": 1000},
    "max_child_chars": {"type": "integer", "minimum": 400}
  },
  "$defs": {
    "parent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "heading", "text", "start", "end", "text_sha256", "char_count", "structural_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^parent-[0-9a-f]{16}$"},
        "heading": {"type": "string"}, "text": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "char_count": {"type": "integer", "minimum": 1}, "structural_path": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parent_id", "index", "heading", "structural_path", "char_count", "text_sha256", "strategy"],
      "properties": {
        "id": {"type": "string", "pattern": "^child-[0-9a-f]{16}$"},
        "parent_id": {"type": "string", "pattern": "^parent-[0-9a-f]{16}$"},
        "index": {"type": "integer", "minimum": 0}, "heading": {"type": "string"},
        "structural_path": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "text": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "char_count": {"type": "integer", "minimum": 1}, "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "strategy": {"enum": ["structural", "hard_limit"]}
      }
    }
  }
}
