{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/specs/v1/memory-plane.schema.json",
  "title": "Memory Plane M1 contract",
  "type": "object",
  "$defs": {
    "bank_create_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "data_classification", "retention_days"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "scope": {"enum": ["user", "project", "agent"]},
        "data_classification": {"enum": ["Public", "Internal"]},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650}
      }
    },
    "source_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "content", "occurred_at", "data_classification"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9 ._:/@+-]+$"},
        "content": {"type": "string", "minLength": 1, "maxLength": 12000},
        "occurred_at": {"type": "string", "format": "date-time"},
        "data_classification": {"enum": ["Public", "Internal"]}
      }
    },
    "fact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "kind", "confidence", "occurred_at"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "kind": {"enum": ["objective", "entity", "fact", "constraint", "preference", "decision", "state"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 6000},
        "occurred_at": {"type": "string", "format": "date-time"},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_to": {"type": ["string", "null"], "format": "date-time"},
        "supersedes_fact_id": {"type": ["string", "null"], "pattern": "^memfact_[a-f0-9]{32}$"}
      }
    },
    "retain_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "facts"],
      "properties": {
        "source": {"$ref": "#/$defs/source_input"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/fact_input"}}
      }
    },
    "recall_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5},
        "as_of": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "memory_bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "owner", "name", "scope", "data_classification", "retention_days", "policy_version", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^membank_[a-f0-9]{32}$"},
        "workspace_id": {"const": "ws_local"},
        "owner": {"const": "local_admin"},
        "name": {"type": "string"},
        "scope": {"enum": ["user", "project", "agent"]},
        "data_classification": {"enum": ["Public", "Internal"]},
        "retention_days": {"type": "integer"},
        "policy_version": {"const": "memory-policy@1"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "bank_id", "query", "memory_status", "channels", "evidence"],
      "properties": {
        "schema_version": {"const": "evidence-bundle@1"},
        "bank_id": {"type": "string", "pattern": "^membank_[a-f0-9]{32}$"},
        "query": {"type": "string"},
        "memory_status": {"enum": ["available", "empty"]},
        "channels": {"type": "array", "items": {"enum": ["keyword", "temporal"]}},
        "evidence": {"type": "array", "maxItems": 10}
      }
    }
  }
}
