{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/specs/v1/memory-plane.schema.json",
  "title": "Memory Plane M1 contract",
  "type": "object",
  "$defs": {
    "local_http_memory_semantic_status": {
      "description": "Admission file projection, not execution admission or measured call counters.",
      "type": "object", "additionalProperties": false,
      "required": ["status", "admission_enabled", "runtime_enabled", "model_calls", "external_calls", "blocker_count", "error"],
      "properties": {
        "status": {"enum": ["not_admitted", "admitted", "invalid_not_admitted"]},
        "admission_enabled": {"type": "boolean"}, "runtime_enabled": {"const": false},
        "model_calls": {"type": "integer", "minimum": 0},
        "external_calls": {"type": "integer", "minimum": 0},
        "blocker_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "error": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "admitted"}}},
         "then": {"properties": {"admission_enabled": {"const": true}, "error": {"const": null}}},
         "else": {"properties": {"admission_enabled": {"const": false}, "model_calls": {"const": 0}, "external_calls": {"const": 0}}}},
        {"if": {"properties": {"status": {"const": "invalid_not_admitted"}}},
         "then": {"properties": {"blocker_count": {"const": 1}, "error": {"type": "string", "minLength": 1}}},
         "else": {"properties": {"error": {"const": null}}}}
      ]
    },
    "local_http_memory_keyword_status": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "ready", "rebuildable_from", "error"],
      "properties": {
        "engine": {"enum": ["sqlite-fts5@1", null]}, "ready": {"type": "boolean"},
        "rebuildable_from": {"const": "canonical_active_facts"}, "error": {"type": ["string", "null"]}
      },
      "if": {"properties": {"ready": {"const": true}}},
      "then": {"properties": {"engine": {"const": "sqlite-fts5@1"}, "error": {"const": null}}},
      "else": {"properties": {"engine": {"const": null}, "error": {"type": "string"}}}
    },
    "local_http_memory_runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "status", "write_mode", "recall_mode", "model_extraction", "reflect", "vector_index", "graph_index", "graph_recall", "entity_catalog", "product_task_run_integration", "keyword_index", "as_of_visibility", "semantic_retrieval", "summary_mode", "recent_turns", "note"],
      "properties": {
        "mode": {"const": "memory-plane-m3b@1"}, "status": {"const": "available_local_admin"},
        "write_mode": {"const": "explicit_source_fact_entity_relation_only"},
        "recall_mode": {"const": ["keyword", "temporal", "context_catalog", "detail_by_id", "explicit_graph_temporal"]},
        "model_extraction": {"const": false}, "reflect": {"const": false},
        "vector_index": {"const": false}, "graph_index": {"const": false},
        "product_task_run_integration": {"const": false},
        "graph_recall": {
          "type": "object", "additionalProperties": false,
          "required": ["engine", "max_hops", "automatic_entity_resolution"],
          "properties": {"engine": {"const": "sqlite-explicit-relation-store@1"}, "max_hops": {"const": 2}, "automatic_entity_resolution": {"const": false}}
        },
        "entity_catalog": {
          "type": "object", "additionalProperties": false,
          "required": ["match_mode", "automatic_entity_resolution", "max_candidates"],
          "properties": {"match_mode": {"const": "exact_canonical_or_alias_casefold"}, "automatic_entity_resolution": {"const": false}, "max_candidates": {"const": 16}}
        },
        "keyword_index": {"$ref": "#/$defs/local_http_memory_keyword_status"},
        "as_of_visibility": {
          "type": "object", "additionalProperties": false,
          "required": ["source_occurred_at", "fact_occurred_at", "fact_validity_window"],
          "properties": {"source_occurred_at": {"const": true}, "fact_occurred_at": {"const": true}, "fact_validity_window": {"const": true}}
        },
        "semantic_retrieval": {"$ref": "#/$defs/local_http_memory_semantic_status"},
        "summary_mode": {"const": "fact_derived_not_model_generated"},
        "recent_turns": {"const": "caller_provided_transient_not_persisted"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "local_http_memory_bank_list": {
      "type": "object", "additionalProperties": false, "required": ["items", "runtime"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/memory_bank"}},
        "runtime": {"$ref": "#/$defs/local_http_memory_runtime"}
      }
    },
    "local_http_memory_bank_detail": {
      "type": "object", "additionalProperties": false, "required": ["bank", "counts", "runtime"],
      "properties": {
        "bank": {"$ref": "#/$defs/memory_bank"},
        "counts": {
          "description": "Persisted source/fact rows, not active recall counts.",
          "type": "object", "additionalProperties": false, "required": ["sources", "facts"],
          "properties": {"sources": {"type": "integer", "minimum": 0}, "facts": {"type": "integer", "minimum": 0}}
        },
        "runtime": {"$ref": "#/$defs/local_http_memory_runtime"}
      }
    },
    "bank_create_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "data_classification", "retention_days"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "scope": {"enum": ["user", "project", "agent"]},
        "data_classification": {"enum": ["Public", "Internal"]},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650}
      }
    },
    "source_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "content", "occurred_at", "data_classification"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9 ._:/@+-]+$"},
        "content": {"type": "string", "minLength": 1, "maxLength": 12000},
        "occurred_at": {"type": "string", "format": "date-time"},
        "data_classification": {"enum": ["Public", "Internal"]}
      }
    },
    "fact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "kind", "confidence", "occurred_at"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "kind": {"enum": ["objective", "entity", "fact", "constraint", "preference", "decision", "state"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 6000},
        "occurred_at": {"type": "string", "format": "date-time"},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_to": {"type": ["string", "null"], "format": "date-time"},
        "supersedes_fact_id": {"type": ["string", "null"], "pattern": "^memfact_[a-f0-9]{32}$"}
      }
    },
    "retain_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "facts"],
      "properties": {
        "source": {"$ref": "#/$defs/source_input"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/fact_input"}}
      }
    },
    "recall_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5},
        "as_of": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "memory_bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "owner", "name", "scope", "data_classification", "retention_days", "policy_version", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^membank_[a-f0-9]{32}$"},
        "workspace_id": {"const": "ws_local"},
        "owner": {"const": "local_admin"},
        "name": {"type": "string"},
        "scope": {"enum": ["user", "project", "agent"]},
        "data_classification": {"enum": ["Public", "Internal"]},
        "retention_days": {"type": "integer"},
        "policy_version": {"const": "memory-policy@1"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "bank_id", "query", "memory_status", "channels", "evidence"],
      "properties": {
        "schema_version": {"const": "evidence-bundle@1"},
        "bank_id": {"type": "string", "pattern": "^membank_[a-f0-9]{32}$"},
        "query": {"type": "string"},
        "memory_status": {"enum": ["available", "empty"]},
        "channels": {"type": "array", "items": {"enum": ["keyword", "temporal"]}},
        "evidence": {"type": "array", "maxItems": 10}
      }
    }
  }
}
