{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/schemas/agent-runtime.schema.json",
  "title": "HarnessAgent Local Agent Runtime Contract",
  "description": "Configuration and conversational runtime contracts. Credential references are identifiers only; secrets and tool bindings are not accepted.",
  "$defs": {
    "provider_type": {"type": "string", "enum": ["openai_compatible", "anthropic", "ollama"]},
    "credential_ref": {"type": "string", "pattern": "^keychain://harnessagent/[A-Za-z0-9._-]{1,96}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "provider_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type", "base_url", "credential_ref", "enabled", "adapter_status", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^rtp_[a-f0-9]{32}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "type": {"$ref": "#/$defs/provider_type"},
        "base_url": {"type": "string", "minLength": 8, "maxLength": 500},
        "credential_ref": {"anyOf": [{"$ref": "#/$defs/credential_ref"}, {"type": "null"}]},
        "enabled": {"type": "boolean"},
        "adapter_status": {"type": "string", "enum": ["supported", "not_implemented"]},
        "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "provider_create_request": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "base_url"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100}, "type": {"$ref": "#/$defs/provider_type"},
        "base_url": {"type": "string", "minLength": 8, "maxLength": 500}, "credential_ref": {"$ref": "#/$defs/credential_ref"}, "enabled": {"type": "boolean"}
      }
    },
    "model_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider_profile_id", "display_name", "model_id", "context_window", "enabled", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^rtm_[a-f0-9]{32}$"}, "provider_profile_id": {"type": "string", "pattern": "^rtp_[a-f0-9]{32}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 100}, "model_id": {"type": "string", "minLength": 1, "maxLength": 180},
        "context_window": {"type": "integer", "minimum": 256, "maximum": 2000000}, "enabled": {"type": "boolean"},
        "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "model_create_request": {
      "type": "object", "additionalProperties": false, "required": ["provider_profile_id", "display_name", "model_id", "context_window"],
      "properties": {"provider_profile_id": {"type": "string", "pattern": "^rtp_[a-f0-9]{32}$"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 100}, "model_id": {"type": "string", "minLength": 1, "maxLength": 180}, "context_window": {"type": "integer", "minimum": 256, "maximum": 2000000}, "enabled": {"type": "boolean"}}
    },
    "agent_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "system_prompt", "model_profile_id", "temperature", "max_output_tokens", "max_context_turns", "enabled", "tool_binding_count", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^rta_[a-f0-9]{32}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 100}, "description": {"type": "string", "maxLength": 500},
        "system_prompt": {"type": "string", "minLength": 1, "maxLength": 12000}, "model_profile_id": {"type": "string", "pattern": "^rtm_[a-f0-9]{32}$"},
        "temperature": {"type": "number", "minimum": 0, "maximum": 1}, "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 16384}, "max_context_turns": {"type": "integer", "minimum": 1, "maximum": 100}, "enabled": {"type": "boolean"}, "tool_binding_count": {"const": 0},
        "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "agent_create_request": {
      "type": "object", "additionalProperties": false, "required": ["name", "description", "system_prompt", "model_profile_id", "temperature", "max_output_tokens", "max_context_turns"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 100}, "description": {"type": "string", "maxLength": 500}, "system_prompt": {"type": "string", "minLength": 1, "maxLength": 12000}, "model_profile_id": {"type": "string", "pattern": "^rtm_[a-f0-9]{32}$"}, "temperature": {"type": "number", "minimum": 0, "maximum": 1}, "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 16384}, "max_context_turns": {"type": "integer", "minimum": 1, "maximum": 100}, "enabled": {"type": "boolean"}}
    },
    "chat_session": {
      "type": "object", "additionalProperties": false, "required": ["id", "agent_profile_id", "title", "status", "created_at", "updated_at"],
      "properties": {"id": {"type": "string", "pattern": "^rts_[a-f0-9]{32}$"}, "agent_profile_id": {"type": "string", "pattern": "^rta_[a-f0-9]{32}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 80}, "status": {"type": "string", "enum": ["active", "archived"]}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}}
    },
    "session_create_request": {"type": "object", "additionalProperties": false, "required": ["agent_profile_id"], "properties": {"agent_profile_id": {"type": "string", "pattern": "^rta_[a-f0-9]{32}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 80}}},
    "chat_message": {
      "type": "object", "additionalProperties": false, "required": ["id", "session_id", "sequence", "role", "content", "created_at"],
      "properties": {"id": {"type": "string", "pattern": "^rtx_[a-f0-9]{32}$"}, "session_id": {"type": "string", "pattern": "^rts_[a-f0-9]{32}$"}, "sequence": {"type": "integer", "minimum": 1}, "role": {"type": "string", "enum": ["user", "assistant"]}, "content": {"type": "string", "minLength": 1, "maxLength": 12000}, "created_at": {"$ref": "#/$defs/timestamp"}}
    },
    "exchange": {
      "type": "object", "additionalProperties": false, "required": ["id", "session_id", "idempotency_key", "request_digest", "user_message_id", "status", "context_message_count", "model_calls", "provider_calls", "created_at", "updated_at"],
      "properties": {"id": {"type": "string", "pattern": "^rte_[a-f0-9]{32}$"}, "session_id": {"type": "string", "pattern": "^rts_[a-f0-9]{32}$"}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128}, "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "user_message_id": {"type": "string", "pattern": "^rtx_[a-f0-9]{32}$"}, "assistant_message_id": {"anyOf": [{"type": "string", "pattern": "^rtx_[a-f0-9]{32}$"}, {"type": "null"}]}, "status": {"type": "string", "enum": ["queued", "streaming", "succeeded", "failed", "cancelled"]}, "error_code": {"anyOf": [{"type": "string", "maxLength": 100}, {"type": "null"}]}, "context_message_count": {"type": "integer", "minimum": 1, "maximum": 200}, "model_calls": {"type": "integer", "minimum": 0, "maximum": 1}, "provider_calls": {"type": "integer", "minimum": 0, "maximum": 1}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}}
    },
    "send_message_request": {"type": "object", "additionalProperties": false, "required": ["content"], "properties": {"content": {"type": "string", "minLength": 1, "maxLength": 12000}}},
    "runtime_stream_event": {"type": "object", "additionalProperties": false, "required": ["type", "exchange_id"], "properties": {"type": {"type": "string", "enum": ["delta", "done", "error"]}, "exchange_id": {"type": "string", "pattern": "^rte_[a-f0-9]{32}$"}, "content": {"type": "string", "maxLength": 12000}, "message_id": {"type": "string", "pattern": "^rtx_[a-f0-9]{32}$"}, "finish_reason": {"type": "string", "enum": ["stop", "cancelled", "error"]}, "error_code": {"type": "string", "maxLength": 100}, "model_calls": {"type": "integer", "minimum": 0, "maximum": 1}, "provider_calls": {"type": "integer", "minimum": 0, "maximum": 1}}}
  }
}
