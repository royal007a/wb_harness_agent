{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["companies", "roles", "concurrency", "failure_policy", "scenario", "timeout_seconds", "max_steps"],
  "properties": {
    "companies": {"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["demo_a","demo_b","demo_c"]}},
    "roles": {"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["financial","industry","risk"]}},
    "concurrency": {"type":"integer","minimum":1,"maximum":3},
    "failure_policy": {"enum":["fail_parent","continue_with_warning"]},
    "scenario": {"enum":["complete","missing_risk"]},
    "timeout_seconds": {"type":"integer","minimum":1,"maximum":120},
    "max_steps": {"type":"integer","minimum":2,"maximum":30}
  }
}
