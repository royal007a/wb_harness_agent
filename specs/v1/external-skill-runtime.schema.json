{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/specs/v1/external-skill-runtime.schema.json",
  "title": "External Skill Runtime contract",
  "type": "object",
  "$defs": {
    "skill_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "skill_id", "version", "entrypoint", "runtime", "capabilities"],
      "properties": {
        "schema_version": {"const": "external-skill-manifest@1"},
        "skill_id": {"type": "string", "pattern": "^ext_[a-z][a-z0-9_-]{2,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "entrypoint": {"const": "entry.py"},
        "runtime": {"const": "python-stdlib@3.12"},
        "capabilities": {"type": "array", "items": {"enum": ["transform_json"]}, "minItems": 1, "maxItems": 1, "uniqueItems": true}
      }
    },
    "package_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_label"],
      "properties": {
        "source_label": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9 ._:/@+-]+$"}
      }
    },
    "execution_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": {
        "input": {"type": "object", "maxProperties": 32, "additionalProperties": true}
      }
    },
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "package_id", "package_sha256", "status", "output", "isolation_profile", "audit"],
      "properties": {
        "execution_id": {"type": "string", "pattern": "^extx_[a-f0-9]{32}$"},
        "package_id": {"type": "string", "pattern": "^extpkg_[a-f0-9]{32}$"},
        "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"const": "succeeded"},
        "output": {"type": "object"},
        "isolation_profile": {"const": "external-skill-stdlib-v1"},
        "audit": {"$ref": "#/$defs/external_skill_execution_audit"}
      }
    },
    "external_skill_execution_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["isolation_profile", "profile_sha256", "image_id", "duration_ms", "container_cleaned", "input_sha256", "output_sha256", "executed_at"],
      "properties": {
        "isolation_profile": {"const": "external-skill-stdlib-v1"},
        "backend": {"enum": ["colima", "linux-docker"]},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "container_cleaned": {"const": true},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "executed_at": {"type": "string", "format": "date-time"}
      }
    },
    "local_http_external_skill_runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "runtime_enabled", "backend", "access_scope", "max_concurrency", "isolation_profile", "image_id", "package_sources", "network", "host_paths", "credentials", "blockers"],
      "properties": {
        "mode": {"const": "external-skill-runtime@1"},
        "runtime_enabled": {"type": "boolean"},
        "backend": {"enum": ["colima", "linux-docker"]},
        "access_scope": {"const": "direct_loopback_or_ssh_tunnel"},
        "max_concurrency": {"const": 1},
        "isolation_profile": {"const": "external-skill-stdlib-v1"},
        "image_id": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "package_sources": {"const": ["local_zip_upload_only"]},
        "network": {"const": "denied"},
        "host_paths": {"const": "denied_except_immutable_package_and_request_mounts"},
        "credentials": {"const": "not_injected"},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 2}
      },
      "allOf": [
        {"if": {"properties": {"runtime_enabled": {"const": false}}}, "then": {"properties": {"blockers": {"contains": {"const": "external_skill_runtime_disabled"}}}}, "else": {"properties": {"blockers": {"not": {"contains": {"const": "external_skill_runtime_disabled"}}}}}},
        {"if": {"properties": {"image_id": {"type": "string"}}}, "then": {"properties": {"blockers": {"items": {"const": "external_skill_runtime_disabled"}}}}, "else": {"properties": {"blockers": {"contains": {"not": {"const": "external_skill_runtime_disabled"}}}}}}
      ]
    },
    "local_http_external_skill_package": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "manifest", "source_label", "content_sha256", "storage", "created_at", "execution_count"],
      "properties": {
        "id": {"type": "string", "pattern": "^extpkg_[a-f0-9]{32}$"},
        "manifest": {"$ref": "#/$defs/skill_manifest"},
        "source_label": {"$ref": "#/$defs/package_registration/properties/source_label"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "storage": {"const": "controlled_immutable_directory"},
        "created_at": {"type": "string", "format": "date-time"},
        "execution_count": {"type": "integer", "minimum": 0}
      }
    },
    "local_http_external_skill_list": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "runtime"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/local_http_external_skill_package"}},
        "runtime": {"$ref": "#/$defs/local_http_external_skill_runtime"}
      }
    }
  }
}
