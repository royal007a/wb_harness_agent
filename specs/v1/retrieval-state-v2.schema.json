{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessagent.local/schemas/retrieval-state-v2.schema.json",
  "title": "HarnessAgent Agentic Retrieval State v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "policy", "strategy_tiers", "goals", "rounds", "initial_budget", "remaining_budget", "cache_policy", "stop_reason"],
  "properties": {
    "schema_version": {"const": "retrieval-state@2"},
    "session_id": {"type": "string", "minLength": 1},
    "policy": {"$ref": "#/$defs/policy"},
    "strategy_tiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/strategy"}},
    "goals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/goal"}},
    "rounds": {"type": "array", "items": {"$ref": "#/$defs/round"}},
    "initial_budget": {"$ref": "#/$defs/budget"},
    "remaining_budget": {"$ref": "#/$defs/budget"},
    "cache_policy": {"$ref": "#/$defs/cache"},
    "stop_reason": {"type": ["string", "null"], "enum": [null, "evidence_sufficient", "gaps_covered", "minimal_target_satisfied", "no_progress", "duplicate_rate", "sources_exhausted", "budget_exhausted", "budget_degraded", "unretrievable_gap", "clarification_required", "max_rounds"]}
  },
  "$defs": {
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_rounds", "dup_threshold", "near_duplicate_jaccard", "min_new_evidence", "no_progress_rounds", "min_evidence_per_claim"],
      "properties": {
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
        "dup_threshold": {"type": "number", "const": 0.8},
        "near_duplicate_jaccard": {"type": "number", "const": 0.8},
        "min_new_evidence": {"type": "integer", "const": 2},
        "no_progress_rounds": {"type": "integer", "const": 2},
        "min_evidence_per_claim": {"type": "integer", "const": 1}
      }
    },
    "strategy": {
      "type": "object", "additionalProperties": false, "required": ["tier", "id", "admitted", "admission_ref"],
      "properties": {
        "tier": {"type": "integer", "minimum": 1, "maximum": 3},
        "id": {"enum": ["local_keyword", "local_temporal_graph", "admitted_semantic_or_external"]},
        "admitted": {"type": "boolean"},
        "admission_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"admitted": {"const": true}}}, "then": {"required": ["admission_ref"], "properties": {"admission_ref": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"id": {"const": "admitted_semantic_or_external"}}}, "then": {"properties": {"tier": {"const": 3}, "admitted": {"const": false}, "admission_ref": {"const": null}}}},
        {"if": {"properties": {"id": {"const": "local_keyword"}}}, "then": {"properties": {"tier": {"const": 1}, "admitted": {"const": true}}}},
        {"if": {"properties": {"id": {"const": "local_temporal_graph"}}}, "then": {"properties": {"tier": {"const": 2}, "admitted": {"const": true}}}}
      ]
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_id", "title", "independent_value", "claims", "depends_on", "status", "user_confirmation", "blocking_gap_ids", "evidence_count_by_claim"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^goal:[a-z0-9_-]+$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "independent_value": {"type": "boolean", "const": true},
        "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^goal:[a-z0-9_-]+$"}, "uniqueItems": true},
        "status": {"enum": ["planned", "active", "completed", "blocked", "cancelled"]},
        "user_confirmation": {"enum": ["not_requested", "pending", "confirmed", "declined"]},
        "blocking_gap_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_count_by_claim": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "round": {
      "type": "object", "additionalProperties": false,
      "required": ["round", "goal_id", "query_key", "methods", "strategy_tier", "candidate_evidence_ids", "new_evidence_ids", "open_gap_ids", "budget_spent", "remaining_budget_after", "continue_reason", "next_round_goal", "attempt", "rerun_reason"],
      "properties": {
        "round": {"type": "integer", "minimum": 1},
        "goal_id": {"type": "string", "pattern": "^goal:[a-z0-9_-]+$"},
        "query_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "methods": {"type": "array", "minItems": 1, "items": {"enum": ["keyword", "temporal", "graph", "semantic", "api"]}, "uniqueItems": true},
        "strategy_tier": {"type": "integer", "minimum": 1, "maximum": 3},
        "candidate_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "new_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "open_gap_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "budget_spent": {"$ref": "#/$defs/budget"},
        "remaining_budget_after": {"$ref": "#/$defs/budget"},
        "strategy_change": {"type": ["object", "null"], "additionalProperties": false, "required": ["from_tier", "to_tier", "reason"], "properties": {"from_tier": {"type": "integer"}, "to_tier": {"type": "integer"}, "reason": {"type": "string", "minLength": 1}}},
        "continue_reason": {"type": ["string", "null"], "maxLength": 500},
        "next_round_goal": {"type": ["string", "null"], "maxLength": 200},
        "attempt": {"type": "integer", "minimum": 1},
        "rerun_reason": {"type": ["string", "null"], "maxLength": 500}
      },
      "allOf": [{"if": {"properties": {"attempt": {"exclusiveMinimum": 1}}}, "then": {"required": ["rerun_reason"], "properties": {"rerun_reason": {"type": "string", "minLength": 1}}}}]
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["elapsed_ms", "token_count", "tool_calls", "cost_minor"],
      "properties": {"elapsed_ms": {"type": "integer", "minimum": 0}, "token_count": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "cost_minor": {"type": "integer", "minimum": 0}}
    },
    "cache": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "negative_cache", "ttl_seconds", "identity_scope_digest", "invalidation_mode"],
      "properties": {
        "enabled": {"const": false},
        "negative_cache": {"const": false},
        "ttl_seconds": {"type": "integer", "minimum": 1},
        "identity_scope_digest": {"const": null},
        "invalidation_mode": {"const": "evidence_reverse_index"}
      }
    }
  }
}
